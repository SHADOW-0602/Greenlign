# Neon serverless Postgres — get from Neon dashboard → Connection Details → Connection string
# Copy the "asyncpg" version and append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/greenlign?sslmode=require

REDIS_URL=redis://redis:6379/0

# --- Object Storage ---
# LOCAL DEV (MinIO running in Docker Compose — these defaults work out of the box):
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=greenlign-raw

# PRODUCTION (Backblaze B2 — replace the four vars above with B2 values):
# S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com   # your B2 region endpoint
# S3_ACCESS_KEY=your-b2-keyID
# S3_SECRET_KEY=your-b2-applicationKey
# S3_BUCKET_NAME=greenlign-raw
# (No other code change needed — boto3 uses endpoint_url to route to B2)

SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Groq LLM — used from Phase 2+ only, not needed for Phase 0
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
